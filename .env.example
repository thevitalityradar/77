# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://77review.com"

# NEXT_PUBLIC_SITE_URL or VITE_SITE_URL: Canonical public website domain
VITE_SITE_URL="https://77review.com"

# Optional Affiliate Tracking Prefix (for ClickBank / BuyGoods / ShareASale)
VITE_AFFILIATE_TRACKING_PREFIX="77rev"
